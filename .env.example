# GEMINI_API_KEY: Optional if AI capabilities are added
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# DATABASE_URL: Supabase PostgreSQL Connection Pooler (Port 6543, pgbouncer=true)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Supabase PostgreSQL Direct Connection for Prisma Migrations (Port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# SUPABASE_URL: Supabase API project endpoint
SUPABASE_URL="https://[PROJECT_REF].supabase.co"

# SUPABASE_ANON_KEY: Public client key for Supabase Auth
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# SUPABASE_SERVICE_ROLE_KEY: Backend only service role key for managing users. NEVER expose to browser!
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# CORS_ORIGIN: Allowed origins for API
CORS_ORIGIN="http://localhost:3000,https://eye.denimcrafts.com"

# Server Port
PORT=4000

# Initial Admin User for Seed Script
FIRST_ADMIN_EMAIL="admin@denimcrafts.com"
FIRST_ADMIN_NAME="Usman Tariq"
